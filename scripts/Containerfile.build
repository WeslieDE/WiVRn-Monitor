# Build image for the AppImage payload: Ubuntu 22.04 (glibc 2.35) so the binaries run on older distros.
# (nasm speeds up the bundled OpenH264 video encoder; the build also works without it, only slower at runtime.)
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl build-essential pkg-config glslang-tools binutils nasm \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && chmod -R a+rwX /opt/rustup /opt/cargo
